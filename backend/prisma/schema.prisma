generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(50)
  users User[]

  @@map("roles")
}

model User {
  id            Int               @id @default(autoincrement())
  email         String            @unique @db.VarChar(255)
  password_hash String            @db.VarChar(255)
  roleId        Int               @map("role_id")
  isActive      Boolean?          @default(true) @map("is_active")
  createdAt     DateTime?         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime?         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  auditLogs     AuditLog[]
  admin         Admin?
  doctor        Doctor?
  nurse         Nurse?
  patient       Patient?
  role          Role              @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medicalDocuments MedicalDocument[] @relation("UploadedBy")
  notifications Notification[]

  @@map("users")
}

model Gender {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(20)
  patients Patient[]

  @@map("genders")
}

model BloodGroup {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(10)
  patients Patient[]

  @@map("blood_groups")
}


model Patient {
  id                    Int                @id @default(autoincrement())
  userId                Int                @unique @map("user_id")
  firstName             String             @map("first_name") @db.VarChar(100)
  lastName              String             @map("last_name") @db.VarChar(100)
  dateOfBirth           DateTime           @map("date_of_birth") @db.Date
  genderId              Int?               @map("gender_id")
  bloodGroupId          Int?               @map("blood_group_id")
  phone                 String?            @db.VarChar(20)
  address               String?
  city                  String?            @db.VarChar(100)
  state                 String?            @db.VarChar(100)
  emergencyContactName  String?            @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactPhone String?            @map("emergency_contact_phone") @db.VarChar(20)
  ward                  String?            @db.VarChar(100)
  bedNumber             String?            @map("bed_number") @db.VarChar(50)
  admissionStatus       String?            @default("Active") @map("admission_status") @db.VarChar(50)
  createdAt             DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime?          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  appointments          Appointment[]
  medicalDocuments      MedicalDocument[]
  medicalRecords        MedicalRecord[]
  medicineReminders     MedicineReminder[]
  observations          PatientObservation[]
  bloodGroup            BloodGroup?        @relation(fields: [bloodGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gender                Gender?            @relation(fields: [genderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prescriptions         Prescription[]
  dischargeSummaries    DischargeSummary[]
  nursingSummaries      NursingPatientSummary[]

  @@map("patients")
}

model Doctor {
  id                Int             @id @default(autoincrement())
  userId            Int             @unique @map("user_id")
  firstName         String          @map("first_name") @db.VarChar(100)
  lastName          String          @map("last_name") @db.VarChar(100)
  specializationId  Int?            @map("specialization_id")
  departmentId      Int?            @map("department_id")
  licenseNumber     String?         @unique @map("license_number") @db.VarChar(100)
  phone             String?         @db.VarChar(20)
  yearsOfExperience Int?            @map("years_of_experience")
  createdAt         DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  appointments      Appointment[]
  department        Department?     @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  specialization    Specialization? @relation(fields: [specializationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medicalRecords    MedicalRecord[]
  prescriptions     Prescription[]
  availabilities    DoctorAvailability[]
  dischargeSummaries DischargeSummary[]

  @@map("doctors")
}

model Nurse {
  id                 Int                  @id @default(autoincrement())
  nurseId            String?              @unique @map("nurse_id") @db.VarChar(50)
  userId             Int                  @unique @map("user_id")
  firstName          String               @map("first_name") @db.VarChar(100)
  lastName           String               @map("last_name") @db.VarChar(100)
  departmentId       Int?                 @map("department_id")
  registrationNumber String?              @unique @map("registration_number") @db.VarChar(100)
  licenseNumber      String?              @unique @map("license_number") @db.VarChar(100)
  phone              String?              @db.VarChar(20)
  assignedWard       String?              @map("assigned_ward") @db.VarChar(100)
  createdAt          DateTime?            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime?            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  department         Department?          @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  observations       PatientObservation[]
  nursingSummaries   NursingPatientSummary[]

  @@map("nurses")
}

model Admin {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique @map("user_id")
  firstName  String    @map("first_name") @db.VarChar(100)
  lastName   String    @map("last_name") @db.VarChar(100)
  phone      String?   @db.VarChar(20)
  hospitalId Int?      @map("hospital_id")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("admins")
}

model Hospital {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(255)
  address     String?
  city        String?      @db.VarChar(100)
  state       String?      @db.VarChar(100)
  phone       String?      @db.VarChar(20)
  email       String?      @db.VarChar(255)
  createdAt   DateTime?    @default(now()) @map("created_at") @db.Timestamp(6)
  admins      Admin[]
  departments Department[]
  procedures  HospitalProcedure[]

  @@map("hospitals")
}

model Specialization {
  id      Int      @id @default(autoincrement())
  name    String   @unique @db.VarChar(150)
  doctors Doctor[]

  @@map("specializations")
}

model Department {
  id          Int      @id @default(autoincrement())
  hospitalId  Int      @map("hospital_id")
  name        String   @db.VarChar(150)
  description String?
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  doctors     Doctor[]
  nurses      Nurse[]
  procedures  HospitalProcedure[]

  @@map("departments")
}

model AppointmentStatus {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(50)
  appointments Appointment[]

  @@map("appointment_statuses")
}

model Appointment {
  id              Int               @id @default(autoincrement())
  patientId       Int               @map("patient_id")
  doctorId        Int               @map("doctor_id")
  appointmentDate DateTime          @map("appointment_date") @db.Date
  appointmentTime DateTime          @map("appointment_time") @db.Time(6)
  statusId        Int               @map("status_id")
  reason          String?
  notes           String?
  createdAt       DateTime?         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  doctor          Doctor            @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status          AppointmentStatus @relation(fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medicalRecords  MedicalRecord[]
  prescriptions   Prescription[]

  @@map("appointments")
}

model Medicine {
  id                Int                @id @default(autoincrement())
  name              String             @db.VarChar(255)
  genericName       String?            @map("generic_name") @db.VarChar(255)
  category          String?            @db.VarChar(100)
  unit              String?            @db.VarChar(50)
  description       String?
  medicineReminders MedicineReminder[]
  prescriptionItems PrescriptionItem[]

  @@map("medicines")
}

model Prescription {
  id             Int                @id @default(autoincrement())
  patientId      Int                @map("patient_id")
  doctorId       Int                @map("doctor_id")
  appointmentId  Int?               @map("appointment_id")
  diagnosis      String?
  notes          String?
  prescribedDate DateTime           @map("prescribed_date") @db.Date
  validUntil     DateTime?          @map("valid_until") @db.Date
  createdAt      DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  items          PrescriptionItem[]
  appointment    Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  doctor         Doctor             @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("prescriptions")
}

model PrescriptionItem {
  id             Int                @id @default(autoincrement())
  prescriptionId Int                @map("prescription_id")
  medicineId     Int                @map("medicine_id")
  dosage         String             @db.VarChar(100)
  frequency      String?            @db.VarChar(100)
  durationDays   Int?               @map("duration_days")
  instructions   String?
  reminders      MedicineReminder[]
  medicine       Medicine           @relation(fields: [medicineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prescription   Prescription       @relation(fields: [prescriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("prescription_items")
}

model RecordType {
  id             Int             @id @default(autoincrement())
  name           String          @unique @db.VarChar(100)
  medicalRecords MedicalRecord[]

  @@map("record_types")
}

model MedicalRecord {
  id            Int               @id @default(autoincrement())
  patientId     Int               @map("patient_id")
  doctorId      Int               @map("doctor_id")
  appointmentId Int?              @map("appointment_id")
  recordTypeId  Int               @map("record_type_id")
  title         String            @db.VarChar(255)
  description   String?
  recordDate    DateTime          @map("record_date") @db.Date
  createdAt     DateTime?         @default(now()) @map("created_at") @db.Timestamp(6)
  documents     MedicalDocument[]
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  doctor        Doctor            @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recordType    RecordType        @relation(fields: [recordTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("medical_records")
}

model DocumentType {
  id               Int               @id @default(autoincrement())
  name             String            @unique @db.VarChar(100)
  medicalDocuments MedicalDocument[]

  @@map("document_types")
}

model MedicalDocument {
  id             Int            @id @default(autoincrement())
  patientId      Int            @map("patient_id")
  recordId       Int?           @map("record_id")
  documentTypeId Int            @map("document_type_id")
  fileName       String         @map("file_name") @db.VarChar(255)
  filePath       String         @map("file_path")
  fileSizeKb     Int?           @map("file_size_kb")
  uploadedById   Int            @map("uploaded_by_id")
  uploadedAt     DateTime?      @default(now()) @map("uploaded_at") @db.Timestamp(6)
  documentType   DocumentType   @relation(fields: [documentTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  record         MedicalRecord? @relation(fields: [recordId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploadedBy     User           @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("medical_documents")
}

model ReminderStatus {
  id                Int                @id @default(autoincrement())
  name              String             @unique @db.VarChar(50)
  medicineReminders MedicineReminder[]

  @@map("reminder_statuses")
}

model MedicineReminder {
  id                 Int               @id @default(autoincrement())
  patientId          Int               @map("patient_id")
  prescriptionItemId Int?              @map("prescription_item_id")
  medicineId         Int               @map("medicine_id")
  reminderTime       DateTime          @map("reminder_time") @db.Time(6)
  frequency          String?           @db.VarChar(100)
  startDate          DateTime          @map("start_date") @db.Date
  endDate            DateTime?         @map("end_date") @db.Date
  statusId           Int               @map("status_id")
  createdAt          DateTime?         @default(now()) @map("created_at") @db.Timestamp(6)
  medicine           Medicine          @relation(fields: [medicineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prescriptionItem   PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status             ReminderStatus    @relation(fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("medicine_reminders")
}

model NotificationType {
  id            Int            @id @default(autoincrement())
  name          String         @unique @db.VarChar(100)
  notifications Notification[]

  @@map("notification_types")
}

model Notification {
  id                 Int              @id @default(autoincrement())
  userId             Int              @map("user_id")
  notificationTypeId Int              @map("notification_type_id")
  title              String           @db.VarChar(255)
  message            String
  isRead             Boolean?         @default(false) @map("is_read")
  createdAt          DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  notificationType   NotificationType @relation(fields: [notificationTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notifications")
}

model ActionType {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(50)
  auditLogs AuditLog[]

  @@map("action_types")
}

model AuditLog {
  id           Int        @id @default(autoincrement())
  userId       Int?       @map("user_id")
  actionTypeId Int        @map("action_type_id")
  tableName    String     @map("table_name") @db.VarChar(100)
  recordId     Int?       @map("record_id")
  oldValues    Json?      @map("old_values")
  newValues    Json?      @map("new_values")
  ipAddress    String?    @map("ip_address") @db.VarChar(45)
  createdAt    DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  actionType   ActionType @relation(fields: [actionTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         User?      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("audit_logs")
}

model PatientObservation {
  id                 Int       @id @default(autoincrement())
  patientId          Int       @map("patient_id")
  nurseId            Int       @map("nurse_id")
  observationDate    DateTime  @map("observation_date") @db.Date
  observationTime    DateTime  @map("observation_time") @db.Time(6)
  temperature        Decimal   @db.Decimal(5, 2)
  pulseRate          Int       @map("pulse_rate")
  respiratoryRate    Int       @map("respiratory_rate")
  systolicBp         Int       @map("systolic_bp")
  diastolicBp        Int       @map("diastolic_bp")
  spo2               Decimal   @db.Decimal(5, 2)
  bloodGlucose       Decimal?  @map("blood_glucose") @db.Decimal(7, 2)
  weight             Decimal?  @db.Decimal(6, 2)
  painScore          Int?      @map("pain_score")
  consciousnessLevel String?   @map("consciousness_level") @db.VarChar(50)
  generalObservation String?   @map("general_observation")
  additionalNotes    String?   @map("additional_notes")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  nurse              Nurse     @relation(fields: [nurseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("patient_observations")
}

model ClinicalGuideline {
  id            Int       @id @default(autoincrement())
  guidelineCode String    @unique @map("guideline_code") @db.VarChar(50)
  title         String    @db.VarChar(255)
  category      String    @db.VarChar(100)
  department    String?   @db.VarChar(150)
  version       String    @db.VarChar(50)
  summary       String
  content       String
  author        String?   @db.VarChar(150)
  tags          String[]  @default([])
  status        String    @default("PUBLISHED") @db.VarChar(50)
  lastUpdated   DateTime  @map("last_updated") @db.Date
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("clinical_guidelines")
}

model DoctorAvailability {
  id                Int       @id @default(autoincrement())
  doctorId          Int       @map("doctor_id")
  date              DateTime  @db.Date
  status            String    @db.VarChar(50) // 'AVAILABLE' | 'ABSENT' | 'ON_LEAVE' | 'UNAVAILABLE'
  startTime         String?   @default("09:00") @map("start_time") @db.VarChar(10)
  endTime           String?   @default("17:00") @map("end_time") @db.VarChar(10)
  reason            String?   @db.VarChar(255)
  nextAvailableDate DateTime? @map("next_available_date") @db.Date
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  doctor            Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([doctorId, date])
  @@index([doctorId, date])
  @@index([status])
  @@map("doctor_availabilities")
}

model DischargeSummary {
  id                     Int       @id @default(autoincrement())
  patientId              Int       @map("patient_id")
  doctorId               Int       @map("doctor_id")
  admissionDate          DateTime  @map("admission_date") @db.Date
  dischargeDate          DateTime  @map("discharge_date") @db.Date
  admissionDiagnosis     String?   @map("admission_diagnosis")
  dischargeDiagnosis     String    @map("discharge_diagnosis")
  chiefComplaint         String?   @map("chief_complaint")
  clinicalCourse         String    @map("clinical_course")
  proceduresPerformed    String?   @map("procedures_performed")
  investigations         String?   @map("investigations")
  treatmentGiven         String?   @map("treatment_given")
  conditionAtDischarge   String    @map("condition_at_discharge") @db.VarChar(100)
  dischargeMedications   Json?     @map("discharge_medications")
  followUpInstructions  String?   @map("follow_up_instructions")
  followUpDate           DateTime? @map("follow_up_date") @db.Date
  followUpDepartment     String?   @map("follow_up_department") @db.VarChar(150)
  dietaryAdvice          String?   @map("dietary_advice")
  activityAdvice         String?   @map("activity_advice")
  warningSigns           String?   @map("warning_signs")
  additionalInstructions String?   @map("additional_instructions")
  summaryStatus          String    @default("DRAFT") @map("summary_status") @db.VarChar(50)
  finalizedAt            DateTime? @map("finalized_at") @db.Timestamp(6)
  finalizedBy            Int?      @map("finalized_by")
  createdAt              DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt              DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  patient                Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  doctor                 Doctor    @relation(fields: [doctorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([patientId])
  @@index([doctorId])
  @@index([summaryStatus])
  @@map("discharge_summaries")
}

model NursingPatientSummary {
  id                      Int       @id @default(autoincrement())
  patientId               Int       @map("patient_id")
  nurseId                 Int       @map("nurse_id")
  summaryDate             DateTime  @map("summary_date") @db.Date
  status                  String    @default("DRAFT") @db.VarChar(50) // DRAFT, SUBMITTED, FINALIZED, CANCELLED
  nursingAssessment       String?   @map("nursing_assessment")
  patientCurrentCondition String    @map("patient_current_condition")
  levelOfConsciousness    String?   @map("level_of_consciousness") @db.VarChar(50)
  mobilityStatus          String?   @map("mobility_status") @db.VarChar(50)
  painStatus              String?   @map("pain_status") @db.VarChar(50)
  vitalSignsSummary       String?   @map("vital_signs_summary")
  observationsSummary     String?   @map("observations_summary")
  nursingCareProvided     String?   @map("nursing_care_provided")
  treatmentSummary        String?   @map("treatment_summary")
  medicationSummary       String?   @map("medication_summary")
  patientResponse         String?   @map("patient_response")
  nutritionStatus         String?   @map("nutrition_status") @db.VarChar(100)
  eliminationStatus       String?   @map("elimination_status") @db.VarChar(100)
  woundCareStatus         String?   @map("wound_care_status")
  patientEducation        String?   @map("patient_education")
  dischargeInstructions   String?   @map("discharge_instructions")
  followUpInstructions   String?   @map("follow_up_instructions")
  warningSignsObserved    String?   @map("warning_signs_observed")
  doctorCommunication     String?   @map("doctor_communication")
  additionalNotes         String?   @map("additional_notes")
  finalizedAt             DateTime? @map("finalized_at") @db.Timestamp(6)
  finalizedBy             Int?      @map("finalized_by")
  createdAt               DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  patient                 Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nurse                   Nurse     @relation(fields: [nurseId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([patientId])
  @@index([nurseId])
  @@index([status])
  @@map("nursing_patient_summaries")
}

model HospitalProcedure {
  id                Int         @id @default(autoincrement())
  hospitalId        Int         @map("hospital_id")
  departmentId      Int?        @map("department_id")
  title             String      @db.VarChar(255)
  procedureCode     String      @unique @map("procedure_code") @db.VarChar(50)
  category          String      @db.VarChar(100)
  description       String      @db.Text
  content           String      @db.Text
  purpose           String?     @db.Text
  scope             String?     @db.Text
  responsibilities  String?     @db.Text
  requiredEquipment String?     @map("required_equipment") @db.Text
  procedureSteps    Json?       @map("procedure_steps")
  safetyPrecautions String?     @map("safety_precautions") @db.Text
  documentationReq  String?     @map("documentation_req") @db.Text
  escalationSteps   String?     @map("escalation_steps") @db.Text
  references        String?     @db.Text
  version           String      @default("1.0") @db.VarChar(50)
  status            String      @default("PUBLISHED") @db.VarChar(50) // DRAFT, UNDER_REVIEW, APPROVED, PUBLISHED, ARCHIVED, CANCELLED
  effectiveDate     DateTime    @map("effective_date") @db.Date
  reviewDate        DateTime?   @map("review_date") @db.Date
  isMandatory       Boolean     @default(false) @map("is_mandatory")
  downloadUrl       String?     @map("download_url") @db.VarChar(255)
  createdBy         Int?        @map("created_by")
  updatedBy         Int?        @map("updated_by")
  createdAt         DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime?   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  hospital          Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([hospitalId])
  @@index([departmentId])
  @@index([status])
  @@index([category])
  @@index([effectiveDate])
  @@map("hospital_procedures")
}

